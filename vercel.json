{
    "buildCommand": "composer install --no-dev --optimize-autoloader",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.0",
            "memory": 512,
            "maxDuration": 30
        }
    },
    "routes": [
        { "source": "/build/(.*)", "destination": "/api/index.php" },
        { "source": "/storage/(.*)", "destination": "/api/index.php" },
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "cleanUrls": true
}
